# ============================================================================
# Ventum — Variables de entorno (todas OPCIONALES)
# La app corre 100% en MODO MOCK sin ninguna de estas variables.
# ============================================================================

# --- Supabase (opcional: activa base de datos real en tiempo real) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Forzar modo mock aunque haya credenciales de Supabase:
# VITE_USE_MOCK=true

# --- Sheila IA con Claude (opcional) ---
# URL de la Edge Function 'sheila' que actúa como proxy seguro a Claude.
# Si está vacía, Sheila usa el motor local determinista (sin API key).
# Ej: https://<tu-proyecto>.supabase.co/functions/v1/sheila
VITE_AI_PROXY_URL=
