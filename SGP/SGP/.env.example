# ============================================================================
# Ventum — Variables de entorno (todas OPCIONALES)
# La app corre 100% en MODO MOCK sin ninguna de estas variables.
# ============================================================================

# --- Supabase (opcional: activa base de datos real en tiempo real) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Forzar modo mock aunque haya credenciales de Supabase:
# VITE_USE_MOCK=true

# --- Sheila IA — proxy (opcional) ---
# URL del proxy seguro de IA. En producción (build desplegado) por defecto
# usa /api/sheila (el servidor Express de este repo). Solo defínela si quieres
# apuntar a otro proxy (p. ej. una Edge Function de Supabase).
# Si el proxy no responde, Sheila cae al motor local determinista.
VITE_AI_PROXY_URL=

# ============================================================================
# SERVIDOR (Railway) — variables del backend, NUNCA se exponen al navegador
# ============================================================================
# API key de Google Gemini para que Sheila responda con IA generativa real.
# Consíguela gratis en https://aistudio.google.com/apikey
# Si está vacía, /api/sheila responde 503 y Sheila usa el motor local.
GEMINI_API_KEY=

# Modelo de Gemini (opcional). Por defecto: gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash
